# Environment Variables for Smart Exam Proctoring System

# Node.js environment
NODE_ENV=development

# Port for the backend server
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB connection URL
MONGODB_URI=mongodb://localhost:27017/smart-proctoring

# JWT secret key for authentication
JWT_SECRET=your-secure-jwt-secret-key-here

# Face verification match distance threshold (default: 0.55)
FACE_MATCH_THRESHOLD=0.55

# Python InsightFace & YOLOv8 microservice URL
# Local development: http://127.0.0.1:8001
# Production (Render): https://your-python-service.onrender.com
PYTHON_DETECTOR_URL=http://127.0.0.1:8001

# Maximum allowed violations before exam auto-termination
MAX_VIOLATIONS=10

# Security middleware flags
ENABLE_HELMET=false
ENABLE_COMPRESSION=false

# =========================================================================
# REAL-TIME EMAIL OTP CONFIGURATION (HTTPS REST APIs bypass cloud SMTP blocks)
# =========================================================================
# Recommended for Cloud (Render Free Tier blocks outbound SMTP):
# Option A: Brevo HTTPS REST API (Port 443 - 300 free emails/day to any recipient)
# BREVO_API_KEY=your-brevo-api-key

# Option B: Resend HTTPS REST API (Port 443 - 100 free emails/day)
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=Athena Proctoring <onboarding@resend.dev>

# Option C: SendGrid HTTPS REST API (Port 443)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Local Development / Dedicated SMTP:
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

