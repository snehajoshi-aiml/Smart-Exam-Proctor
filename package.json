{
  "name": "smart-exam-proctoring-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.js",
    "build": "cd frontend && npm run build",
    "vercel-build": "cd frontend && npm install --legacy-peer-deps && cross-env NODE_OPTIONS=\"--max-old-space-size=2048 --no-deprecation\" npm run build",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "admin": "cd admin && npm start"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.2",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.3",
    "validator": "^13.11.0"
  },
  "overrides": {
    "chokidar": "^4.0.3"
  },
  "allowScripts": {
    "core-js": true,
    "core-js-pure": true
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
