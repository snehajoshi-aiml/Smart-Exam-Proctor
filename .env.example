# ==================== SERVER CONFIGURATION ====================
PORT=5000
NODE_ENV=development

# ==================== DATABASE CONFIGURATION ====================
MONGODB_URI=mongodb://localhost:27017/smart-proctoring

# ==================== CORS CONFIGURATION ====================
# Client URL for CORS (Important: This should match your frontend URL)
CLIENT_URL=http://localhost:5000

# ==================== AUTHENTICATION & SECURITY ====================
# JWT Secret for Authentication (Use a strong random string)
JWT_SECRET=smart-proctoring-super-secret-key-2024-change-this-in-production

# Session Secret for Cookies
SESSION_SECRET=session-secret-key-for-cookie-encryption-change-this

# Session Configuration
SESSION_MAX_AGE=86400000

# ==================== PROCTORING SETTINGS ====================
# Maximum allowed tab switches before warning
MAX_TAB_SWITCHES=3

# Maximum violations before exam auto-termination
MAX_VIOLATIONS=10

# Exam duration in minutes (if time-limited)
EXAM_DURATION=60

# Enable/Disable proctoring features
ENABLE_FACE_DETECTION=true
ENABLE_VOICE_DETECTION=true
ENABLE_PHONE_DETECTION=true
ENABLE_TAB_SWITCH_DETECTION=true
ENABLE_FULLSCREEN_MODE=true

# Screenshot capture on violations
CAPTURE_SCREENSHOTS=true

# ==================== VOICE DETECTION SETTINGS ====================
# Voice detection threshold (0-1) - Lower values are more sensitive
VOICE_THRESHOLD=0.05

# Voice detection duration in milliseconds (continuous speech before alert)
VOICE_DURATION_THRESHOLD=2000

# ==================== FACE DETECTION SETTINGS ====================
# Face detection interval in milliseconds
FACE_DETECTION_INTERVAL=2000

# Face detection confidence threshold (0-1)
FACE_DETECTION_CONFIDENCE=0.5

# ==================== EMAIL CONFIGURATION ====================
# Email settings for notifications (optional - leave blank if not using)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@smartproctoring.com

# ==================== LOGGING & MONITORING ====================
# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Enable detailed logging for debugging
ENABLE_DETAILED_LOGS=true

# Maximum log entries to keep in memory
MAX_LOG_ENTRIES=1000

# ==================== SECURITY SETTINGS ====================
# JWT expiration time (e.g., 24h, 7d)
JWT_EXPIRY=24h

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
ENABLE_HELMET=true

# Compression
ENABLE_COMPRESSION=true

# ==================== ADMIN SETTINGS ====================
# Admin email for notifications
ADMIN_EMAIL=admin@smartproctoring.com

# Enable admin dashboard
ENABLE_ADMIN_DASHBOARD=true

# ==================== FEATURE FLAGS ====================
# Enable/Disable user registration
ENABLE_REGISTRATION=true

# Enable/Disable camera and microphone access
ENABLE_CAMERA_ACCESS=true
ENABLE_MICROPHONE_ACCESS=true

# ==================== DATABASE SETTINGS ====================
# Database connection pool size
DB_POOL_SIZE=10

# Query timeout in milliseconds
QUERY_TIMEOUT_MS=30000

# Enable automatic database backup
ENABLE_AUTO_BACKUP=false

# Backup interval in hours
BACKUP_INTERVAL_HOURS=24

# ==================== DEVELOPMENT SETTINGS ====================
# Enable debug mode (only in development)
DEBUG_MODE=true

# Show stack traces in error responses
SHOW_STACK_TRACES=true

# ==================== PRODUCTION SETTINGS ====================
# Uncomment these lines for production deployment
# NODE_ENV=production
# DEBUG_MODE=false
# SHOW_STACK_TRACES=false
# ENABLE_DETAILED_LOGS=false
# ENABLE_REGISTRATION=false